msgstr ""

msgid "ذخیره تنظیمات"
msgstr ""

msgid "پیش‌نمایش Vazirmatn"
msgstr ""

msgid "نمونه‌های زیر فقط وزن‌هایی را نشان می‌دهند که در فرم انتخاب شده‌اند."
msgstr ""

msgid "متن فارسی برای پیش‌نمایش خوانایی"
msgstr ""

msgid "وزنی انتخاب نشده است. هنگام ذخیره، وزن 400 به‌صورت خودکار فعال می‌شود."
msgstr ""

msgid "شما اجازه تغییر این تنظیمات را ندارید."
msgstr ""

msgid "اعتبارسنجی امنیتی انجام نشد. صفحه را تازه کنید و دوباره ذخیره کنید."
msgstr ""

msgid "تعداد تلاش‌های ذخیره زیاد است. یک دقیقه صبر کنید و دوباره تلاش کنید."
msgstr ""

msgid "هیچ وزن معتبری انتخاب نشده بود؛ وزن 400 به‌صورت خودکار فعال شد."
msgstr ""

msgid "%d خط از استثناءها معتبر نبود و ذخیره نشد. هر خط باید یک CSS selector ساده و مستقل باشد."
msgstr ""

msgid "حداکثر 50 استثناء ذخیره می‌شود؛ موارد بعدی ذخیره نشدند."
msgstr ""

msgid "هر گزینه فقط همان محیط را کنترل می‌کند. با برداشتن علامت، فونت در آن محیط اعمال نمی‌شود."
msgstr ""

msgid "فقط وزن‌هایی را انتخاب کنید که واقعاً نیاز دارید. وزن‌های کمتر می‌توانند دانلود فونت را کاهش دهند. اگر هیچ وزن معتبری انتخاب نشود، وزن 400 هنگام ذخیره برگردانده می‌شود."
msgstr ""

msgid "اگر بخشی از سایت باید فونت خودش را نگه دارد، می‌توانید آن را از اعمال Vazirmatn مستثنی کنید. این بخش برای کاربران آشنا با CSS است و در استفاده عادی لازم نیست تغییر کند."
msgstr ""

msgid "هر خط یک CSS selector مستقل است. خطوط نامعتبر نادیده گرفته می‌شوند و پس از ذخیره هشدار نمایش داده می‌شود."
msgstr ""

